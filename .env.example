# One Baby Shop — environment contract
# Copy to .env.local and fill in real values.
# NEVER commit real credentials. NEVER paste secrets into chats or issues.

# ── Frontend (Vite: only variables prefixed VITE_ reach the client) ─────────
# Public API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000/api/v1

# NOTE: anything prefixed with VITE_ is PUBLIC by definition.
# No secrets, tokens, or private keys may ever use this prefix.
