# ── Database (Docker Compose) ───────────────────────────────────────────────
POSTGRES_USER=babyshop
POSTGRES_PASSWORD=babyshop_dev
POSTGRES_DB=babyshop
POSTGRES_PORT=5432

# Prisma connection string
DATABASE_URL=postgresql://babyshop:babyshop_dev@localhost:5432/babyshop?schema=public

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Secrets (REAL values only in .env — NEVER commit, NEVER paste in chats) ─
# JWT access/refresh secrets: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-in-env-local
JWT_REFRESH_SECRET=change-me-in-env-local-too

# ── Mercado Pago (get test credentials at mercadopago.com.mx/developers) ────
# TEST-... access token from your developer app (Credenciales de prueba)
MP_ACCESS_TOKEN=
# Webhook secret (Configuración → Integraciones → Webhooks). Required to
# verify x-signature on payment notifications.
MP_WEBHOOK_SECRET=
# Public URLs — needed ONLY when deployed (webhooks require public HTTPS).
APP_URL=http://localhost:5173
PUBLIC_API_URL=

# ── Shipping policy (centavos) ─────────────────────────────────────────────
SHIPPING_FLAT_CENTS=9900
FREE_SHIPPING_THRESHOLD_CENTS=50000
